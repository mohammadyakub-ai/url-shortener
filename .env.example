# PostgreSQL connection string. Compose overrides this to point at the `db` service.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/urlshortener

# Redis connection string. Compose overrides this to point at the `redis` service.
REDIS_URL=redis://localhost:6379/0

# Toggle the redirect cache entirely (useful for load-test comparisons).
CACHE_ENABLED=true

# How long positive cache entries live (seconds).
CACHE_TTL_SECONDS=3600

# How long unknown codes are cached so 404 floods hit Redis instead of Postgres.
NEGATIVE_CACHE_TTL_SECONDS=60

# Fixed-window rate limit for POST /shorten, keyed by client IP.
# Set RATE_LIMIT_REQUESTS=0 to disable the limiter (used for load tests).
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Python logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Optional ports for docker-compose port mappings.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
